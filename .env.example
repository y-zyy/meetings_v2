# ── Database ──────────────────────────────────────────────
# 비밀번호 생성: openssl rand -hex 24  (URL 안전 문자만 사용할 것)
# POSTGRES_PASSWORD 와 DATABASE_URL 의 비밀번호는 반드시 같은 값이어야 합니다.
POSTGRES_USER=meetings
POSTGRES_DB=meetings
POSTGRES_PASSWORD=change-me-to-a-long-random-string
DATABASE_URL=postgresql+asyncpg://meetings:change-me-to-a-long-random-string@postgres:5432/meetings

# ── Redis / Celery ────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_VISIBILITY_TIMEOUT=14400
CELERY_TASK_SOFT_TIME_LIMIT=7800
CELERY_TASK_TIME_LIMIT=7920
INGEST_WORKER_CONCURRENCY=2
ASR_WORKER_CONCURRENCY=10
POSTPROCESS_WORKER_CONCURRENCY=10
MINUTES_WORKER_CONCURRENCY=10

# ── Security ──────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── File Storage ──────────────────────────────────────────
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_SIZE_MB=500
UPLOAD_CHUNK_SIZE_MB=4

# ── ASR API ───────────────────────────────────────────────
# Set OPENAI_API_KEY to use OpenAI Whisper; otherwise uses local server.
OPENAI_API_KEY=
ASR_API_URL=http://asr-server:9000/transcribe
ASR_API_KEY=
ASR_FILE_FIELD=file
ASR_RESPONSE_FIELD=text
ASR_TIMEOUT=7200
# 후처리 이후 정렬/화자 분리 (기본: ASR_API_URL 의 /transcribe -> /align_diarize)
ASR_DIARIZE_ENABLED=true
ASR_DIARIZE_API_URL=
ASR_MIN_SPEAKERS=
ASR_MAX_SPEAKERS=

# ── WhisperX server ───────────────────────────────────────
WHISPERX_DEVICE=cuda
WHISPERX_COMPUTE_TYPE=float16
WHISPERX_BATCH_SIZE=16
WHISPERX_MAX_BATCH_SIZE=16
WHISPERX_MAX_CONCURRENCY=1
WHISPERX_UPLOAD_CHUNK_SIZE_MB=4
WHISPERX_MAX_UPLOAD_SIZE_MB=500
# 화자 분리(pyannote) — HuggingFace 토큰 필요 (pyannote/speaker-diarization-community-1 등 약관 동의 필요)
HF_TOKEN=
WHISPERX_DIARIZE=true

# ── LLM API (OpenAI-compatible) ───────────────────────────
LLM_API_BASE_URL=http://llm-server:8000/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o
LLM_TIMEOUT=120
LLM_MAX_TOKENS=4096

# ── Admin default credentials (first run only) ────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=admin@local

