# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://meetings:meetings@postgres:5432/meetings

# ── Redis / Celery ────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Security ──────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── File Storage ──────────────────────────────────────────
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_SIZE_MB=500

# ── ASR API ───────────────────────────────────────────────
# POST multipart/form-data → { "text": "..." }
ASR_API_URL=http://asr-server:9000/transcribe
ASR_API_KEY=
ASR_FILE_FIELD=file
ASR_RESPONSE_FIELD=text
ASR_TIMEOUT=7200

# ── LLM API (OpenAI-compatible) ───────────────────────────
LLM_API_BASE_URL=http://llm-server:8000/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o
LLM_TIMEOUT=120

# ── Admin default credentials (first run only) ────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=admin@local
